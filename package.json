{
  "name": "star-chain-challenge",
  "version": "1.1.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-cockpit.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "dev:classic": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "simulate": "node tests/balance.mjs 12",
    "format:check": "prettier --check src vite.config.ts tsconfig.json playwright.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@playwright/test": "^1.63.0",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1",
    "zustand": "^5.0.15"
  }
}
